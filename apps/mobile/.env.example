# FieldOps mobile environment configuration (template).
#
# One file per build type, in apps/mobile/:
#   .env.development  -> debug builds (npm run android)          [committed]
#   .env.staging      -> staging builds (assembleStaging)        [create when staging exists]
#   .env.production   -> release builds (assembleRelease)        [create when production exists]
#
# IMPORTANT: every value here is compiled into the APK and can be read by anyone who has the
# app. This is public build configuration, NOT a place for secrets. Never put API keys, signing
# passwords, database URLs or any server credential in these files.

# One of: development | staging | production
APP_ENV=development

# Origin of the FieldOps API, without a trailing slash and without /api/v1.
# Development on a USB-connected phone uses adb reverse, so localhost works:
#   adb reverse tcp:3000 tcp:3000
# Staging and production must use https:// (release builds block cleartext HTTP).
API_BASE_URL=http://localhost:3000

# Optional request timeout in milliseconds (1000-120000). Defaults to 15000.
API_TIMEOUT_MS=15000
