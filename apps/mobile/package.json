{
  "name": "@fieldops/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "FieldOps React Native application (Android).",
  "scripts": {
    "start": "react-native start",
    "start:reset": "react-native start --reset-cache",
    "android": "react-native run-android --active-arch-only",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"*.{js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"*.{js,json}\"",
    "test": "jest"
  },
  "codegenConfig": {
    "name": "FieldOpsSpecs",
    "type": "modules",
    "jsSrcsDir": "src/services/native",
    "android": {
      "javaPackageName": "com.fieldops.mobile.specs"
    }
  },
  "dependencies": {
    "@fieldops/shared": "*",
    "@fieldops/types": "*",
    "@react-native-community/datetimepicker": "^9.2.1",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-firebase/app": "^23.0.0",
    "@react-native-firebase/messaging": "^23.0.0",
    "@react-native-vector-icons/ionicons": "^13.1.4",
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "@reduxjs/toolkit": "^2.12.0",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-config": "^1.7.2",
    "react-native-image-picker": "^8.2.1",
    "react-native-keychain": "^10.0.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-nitro-sqlite": "^10.0.0",
    "react-native-reanimated": "^4.7.0",
    "react-native-safe-area-context": "^5.10.0",
    "react-native-screens": "^4.28.0",
    "react-native-worklets": "~0.13.0",
    "react-redux": "^9.3.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@fieldops/config": "*",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "eslint": "^9.39.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
