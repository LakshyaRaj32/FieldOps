# FieldOps API environment configuration (template).
#
# Copy to apps/api/.env for local development (.env is gitignored). Deployed environments
# (staging, production) set these variables in the hosting platform instead of a file.
# Every variable is validated at startup; the API refuses to start with invalid values.
# See docs/backend-development.md.

# development | staging | production
APP_ENV=development

# Interface and port to listen on. Hosting platforms inject PORT.
# 0.0.0.0 accepts connections from other devices (a phone on the same Wi-Fi).
HOST=0.0.0.0
PORT=3000

# PostgreSQL connection string. The local values match docs/backend-development.md.
DATABASE_URL=postgresql://fieldops:fieldops@localhost:5432/fieldops_dev

# JWT signing secrets (HS256). Use two DIFFERENT random values of at least 32 characters:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Staging and production refuse to start with placeholder or short secrets.
JWT_ACCESS_SECRET=replace-me-with-a-random-access-token-secret
JWT_REFRESH_SECRET=replace-me-with-a-different-random-refresh-secret

# Token lifetimes: a number followed by s, m, h or d.
ACCESS_TOKEN_EXPIRATION=15m
# Sliding: each successful refresh extends the session by this much.
REFRESH_TOKEN_EXPIRATION=30d

# Comma-separated browser origins allowed by CORS. The mobile app does not need CORS
# (it is not a browser); leave empty to disable CORS entirely.
CORS_ORIGINS=

# Serve Swagger UI at /api/docs. Defaults to true, except in production.
SWAGGER_ENABLED=true

# Directory where job evidence (photos) is stored, relative to apps/api. Defaults to
# ./storage (gitignored). A deployment points it at a persistent volume.
STORAGE_DIR=./storage

# Push notifications (FCM HTTP v1). Path of the Firebase service-account JSON key
# (Firebase console > Project settings > Service accounts > Generate new private key).
# It is a SECRET: keep it outside git (firebase-service-account*.json is gitignored).
# Leave empty to disable push; in-app notifications and realtime still work.
FCM_SERVICE_ACCOUNT_FILE=
