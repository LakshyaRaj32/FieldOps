# FieldOps API environment configuration (template).
#
# Copy to apps/api/.env for local development (.env is gitignored). Deployed environments
# (staging, production) set these variables in the hosting platform instead of a file.
# Every variable is validated at startup; the API refuses to start with invalid values.
# See docs/backend-development.md.

# development | staging | production
APP_ENV=development

# Interface and port to listen on. Hosting platforms inject PORT.
# 0.0.0.0 accepts connections from other devices (a phone on the same Wi-Fi).
HOST=0.0.0.0
PORT=3000

# PostgreSQL connection string. The local values match docs/backend-development.md.
DATABASE_URL=postgresql://fieldops:fieldops@localhost:5432/fieldops_dev

# JWT signing secrets (HS256). Use two DIFFERENT random values of at least 32 characters:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Staging and production refuse to start with placeholder or short secrets.
JWT_ACCESS_SECRET=replace-me-with-a-random-access-token-secret
JWT_REFRESH_SECRET=replace-me-with-a-different-random-refresh-secret

# Token lifetimes: a number followed by s, m, h or d.
ACCESS_TOKEN_EXPIRATION=15m
# Sliding: each successful refresh extends the session by this much.
REFRESH_TOKEN_EXPIRATION=30d

# Comma-separated browser origins allowed by CORS. The mobile app does not need CORS
# (it is not a browser); leave empty to disable CORS entirely.
CORS_ORIGINS=

# Serve Swagger UI at /api/docs. Defaults to true, except in production.
SWAGGER_ENABLED=true

# Directory where job evidence (photos) is stored, relative to apps/api. Defaults to
# ./storage (gitignored). A deployment points it at a persistent volume.
STORAGE_DIR=./storage

# Where evidence photos are stored: local (STORAGE_DIR) or s3 (an S3-compatible bucket:
# Cloudflare R2 when deployed). Deployments whose disk is not persistent (Render free) must
# use s3. To try it locally, start S3Mock:
#   docker compose -f infra/docker/compose.yaml --profile s3 up -d s3mock
# and use S3_ENDPOINT=http://localhost:9090, S3_BUCKET=fieldops-evidence,
# S3_FORCE_PATH_STYLE=true and any key ID and secret.
STORAGE_DRIVER=local
# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com, region "auto".
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
# R2 API token with Object Read & Write on the bucket. SECRETS: never commit them.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for S3Mock and MinIO; R2 works either way.
S3_FORCE_PATH_STYLE=false

# Push notifications (FCM HTTP v1). Path of the Firebase service-account JSON key
# (Firebase console > Project settings > Service accounts > Generate new private key).
# It is a SECRET: keep it outside git (firebase-service-account*.json is gitignored).
# Leave empty to disable push; in-app notifications and realtime still work.
FCM_SERVICE_ACCOUNT_FILE=

# How often to look for unpaid orders past their due date and notify the shop's managers
# (each order once). A duration such as 15m or 1h, or "off". Defaults to 1h.
OVERDUE_SCAN_INTERVAL=1h

# Redis (cache and shared rate-limit counters). Optional: when empty, nothing is cached and
# rate limits are counted in this process's memory (fine for one instance). Start one with
# `docker compose -f infra/docker/compose.yaml up -d redis`. See docs/redis.md.
REDIS_URL=redis://localhost:6379
# Prepended to every key, so several environments can share one Redis.
REDIS_KEY_PREFIX=fieldops:

# Rate limiting (docs/rate-limiting.md). true by default.
RATE_LIMIT_ENABLED=true
# Override a policy as <requests>/<window>: RATE_LIMIT_DEFAULT, RATE_LIMIT_AUTH,
# RATE_LIMIT_REFRESH, RATE_LIMIT_UPLOAD. Example:
# RATE_LIMIT_AUTH=20/5m

# Background tasks (docs/background-tasks.md). They need REDIS_URL; without it, tasks run
# inline. Set WORKERS_ENABLED=false on instances that should only serve HTTP.
WORKERS_ENABLED=true
# First retry delay of a failed task (doubles on each further retry).
QUEUE_RETRY_DELAY=5s

# Number of reverse proxies in front of the API (0 locally, 1 on Render). The client IP is
# read from X-Forwarded-For through exactly this many hops.
TRUST_PROXY=0
