{
  "name": "@fieldops/api",
  "version": "0.2.0",
  "private": true,
  "description": "FieldOps backend: NestJS modular monolith (REST API).",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "prebuild": "npm run build -w @fieldops/shared",
    "build": "prisma generate && nest build",
    "prestart": "npm run build -w @fieldops/shared",
    "start": "nest start",
    "prestart:dev": "npm run build -w @fieldops/shared",
    "start:dev": "nest start --watch",
    "prestart:debug": "npm run build -w @fieldops/shared",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --type-aware --deny-warnings src/ test/",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "user:set-role": "node --env-file-if-exists=.env scripts/set-role.mjs"
  },
  "dependencies": {
    "@fieldops/shared": "*",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/platform-socket.io": "^12.1.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/websockets": "^12.1.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "bullmq": "^5.81.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@fieldops/config": "*",
    "@fieldops/types": "*",
    "@nestjs/cli": "^12.0.7",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.1.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "prisma": "~7.10.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.3.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=24"
  }
}
