// FieldOps database schema (PostgreSQL).
//
// Conventions (docs/backend-architecture.md, "Data layer"):
// - UUIDv7 primary keys: globally unique, and time-ordered so B-tree inserts stay local.
// - snake_case tables and columns in the database, camelCase in TypeScript (@map/@@map).
// - timestamptz for every timestamp.
// - Every index is justified by a query in the code. Indexing decisions are listed in
//   docs/database.md.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Must stay identical to Role in @fieldops/types (checked at compile time in src/users/role.ts).
enum Role {
  WORKER
  MANAGER
  ADMIN
}

/// Why a session stopped being usable. Kept on the row so revocations can be audited.
enum SessionRevocationReason {
  /// The user signed out on this device (POST /auth/logout).
  LOGOUT
  /// The user signed out everywhere (prepared for POST /auth/logout-all).
  LOGOUT_ALL
  /// An already-rotated refresh token was presented: the token was probably stolen.
  REFRESH_TOKEN_REUSE
}

model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  /// Stored trimmed and lower-cased by the application, so the plain unique index enforces
  /// case-insensitive uniqueness.
  email        String    @unique @db.VarChar(254)
  /// Argon2id PHC string (algorithm, parameters, salt and hash). Never the password.
  passwordHash String    @map("password_hash")
  firstName    String    @map("first_name") @db.VarChar(100)
  lastName     String    @map("last_name") @db.VarChar(100)
  role         Role      @default(WORKER)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions     Session[]

  @@map("users")
}

/// One signed-in device (one login). The refresh token is rotated on every use; the row
/// keeps only the SHA-256 hash of the current token, which is enough to detect reuse of
/// any earlier token of the same session.
model Session {
  id               String                   @id @db.Uuid
  userId           String                   @map("user_id") @db.Uuid
  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Hex SHA-256 of the current refresh token.
  refreshTokenHash String                   @map("refresh_token_hash") @db.Char(64)
  /// Raw User-Agent header, truncated. Helps a user recognize a session; nothing else about
  /// the device is collected.
  userAgent        String?                  @map("user_agent") @db.VarChar(255)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt       DateTime                 @default(now()) @map("last_used_at") @db.Timestamptz(3)
  /// Sliding expiry: pushed forward on every successful refresh.
  expiresAt        DateTime                 @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime?                @map("revoked_at") @db.Timestamptz(3)
  revokedReason    SessionRevocationReason? @map("revoked_reason")

  /// Revoking or listing all sessions of a user (logout-all, account deactivation).
  /// Postgres does not index foreign keys automatically.
  @@index([userId])
  @@map("sessions")
}
