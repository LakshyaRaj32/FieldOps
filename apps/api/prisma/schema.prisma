// FieldOps database schema (PostgreSQL).
//
// Conventions (docs/backend-architecture.md, "Data layer"):
// - UUIDv7 primary keys: globally unique, and time-ordered so B-tree inserts stay local.
// - snake_case tables and columns in the database, camelCase in TypeScript (@map/@@map).
// - timestamptz for every timestamp.
// - Every index is justified by a query in the code. Indexing decisions are listed in
//   docs/database.md.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Must stay identical to Role in @fieldops/types (checked at compile time in src/users/role.ts).
enum Role {
  WORKER
  MANAGER
  ADMIN
}

/// Why a session stopped being usable. Kept on the row so revocations can be audited.
enum SessionRevocationReason {
  /// The user signed out on this device (POST /auth/logout).
  LOGOUT
  /// The user signed out everywhere (prepared for POST /auth/logout-all).
  LOGOUT_ALL
  /// An already-rotated refresh token was presented: the token was probably stolen.
  REFRESH_TOKEN_REUSE
}

model User {
  id             String              @id @default(uuid(7)) @db.Uuid
  /// Stored trimmed and lower-cased by the application, so the plain unique index enforces
  /// case-insensitive uniqueness.
  email          String              @unique @db.VarChar(254)
  /// Argon2id PHC string (algorithm, parameters, salt and hash). Never the password.
  passwordHash   String              @map("password_hash")
  firstName      String              @map("first_name") @db.VarChar(100)
  lastName       String              @map("last_name") @db.VarChar(100)
  role           Role                @default(WORKER)
  isActive       Boolean             @default(true) @map("is_active")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions       Session[]
  assignedJobs   Job[]               @relation("JobAssignedWorker")
  createdJobs    Job[]               @relation("JobCreatedBy")
  jobActions     JobEvent[]          @relation("JobEventActor")
  jobAssignments JobEvent[]          @relation("JobEventAssignee")
  jobNotes       JobNote[]
  mutations      ProcessedMutation[]
  jobEvidence    JobEvidence[]
  jobMessages    JobMessage[]
  pushDevices    PushDevice[]
  notifications  Notification[]

  @@map("users")
}

/// One signed-in device (one login). The refresh token is rotated on every use; the row
/// keeps only the SHA-256 hash of the current token, which is enough to detect reuse of
/// any earlier token of the same session.
model Session {
  id               String                   @id @db.Uuid
  userId           String                   @map("user_id") @db.Uuid
  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Hex SHA-256 of the current refresh token.
  refreshTokenHash String                   @map("refresh_token_hash") @db.Char(64)
  /// Raw User-Agent header, truncated. Helps a user recognize a session; nothing else about
  /// the device is collected.
  userAgent        String?                  @map("user_agent") @db.VarChar(255)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt       DateTime                 @default(now()) @map("last_used_at") @db.Timestamptz(3)
  /// Sliding expiry: pushed forward on every successful refresh.
  expiresAt        DateTime                 @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime?                @map("revoked_at") @db.Timestamptz(3)
  revokedReason    SessionRevocationReason? @map("revoked_reason")
  /// The device's push registration, if it registered one (one per session: a session is
  /// one signed-in device).
  pushDevice       PushDevice?

  /// Revoking or listing all sessions of a user (logout-all, account deactivation).
  /// Postgres does not index foreign keys automatically.
  @@index([userId])
  @@map("sessions")
}

/// Must stay identical to JobStatus in @fieldops/types (checked in src/jobs/job-enums.ts).
/// Allowed transitions live in @fieldops/shared (packages/shared/src/job-state-machine.ts).
enum JobStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum JobPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum JobEventType {
  CREATED
  ASSIGNED
  STARTED
  COMPLETED
  CANCELLED
}

/// A unit of field work. Manager-owned fields (title, customer, address, schedule...) are
/// edited through PATCH with optimistic concurrency on `version`; status changes only through
/// the action endpoints, which also append a JobEvent. Hand-written CHECK constraints in the
/// migration keep status and assignment consistent.
model Job {
  id                 String             @id @default(uuid(7)) @db.Uuid
  title              String             @db.VarChar(200)
  description        String?            @db.VarChar(5000)
  customerName       String             @map("customer_name") @db.VarChar(200)
  address            String             @db.VarChar(500)
  /// WGS 84. Both set or both null (CHECK constraint).
  latitude           Float?             @db.DoublePrecision
  longitude          Float?             @db.DoublePrecision
  scheduledAt        DateTime           @map("scheduled_at") @db.Timestamptz(3)
  priority           JobPriority        @default(NORMAL)
  status             JobStatus          @default(PENDING)
  /// The current assignee (a WORKER). Assignment history is in job_events.
  assignedWorkerId   String?            @map("assigned_worker_id") @db.Uuid
  assignedWorker     User?              @relation("JobAssignedWorker", fields: [assignedWorkerId], references: [id], onDelete: Restrict)
  /// Instructions from the manager. The worker's own notes are JobNote rows.
  notes              String?            @db.VarChar(5000)
  cancellationReason String?            @map("cancellation_reason") @db.VarChar(500)
  createdById        String             @map("created_by_id") @db.Uuid
  createdBy          User               @relation("JobCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  /// Optimistic concurrency: incremented on every change (edits and transitions).
  version            Int                @default(1)
  startedAt          DateTime?          @map("started_at") @db.Timestamptz(3)
  completedAt        DateTime?          @map("completed_at") @db.Timestamptz(3)
  cancelledAt        DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  checklistItems     JobChecklistItem[]
  events             JobEvent[]
  fieldNotes         JobNote[]
  evidence           JobEvidence[]
  messages           JobMessage[]
  notifications      Notification[]

  /// A worker's job list, ordered by schedule (also indexes the foreign key).
  @@index([assignedWorkerId, scheduledAt])
  /// Manager lists filtered by status, ordered by schedule.
  @@index([status, scheduledAt])
  /// Unfiltered manager list: keyset pagination on (scheduled_at, id).
  @@index([scheduledAt, id])
  @@map("jobs")
}

/// A checklist item defined by the manager. Completion (by the worker) is added with
/// checklist execution in a later phase.
model JobChecklistItem {
  id        String   @id @default(uuid(7)) @db.Uuid
  jobId     String   @map("job_id") @db.Uuid
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  position  Int
  label     String   @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  /// Loads a job's checklist in order; one item per position.
  @@unique([jobId, position])
  @@map("job_checklist_items")
}

/// Append-only history of a job: creation, assignments and status changes. Written in the
/// same transaction as the change it records. Never updated or deleted through the API
/// (rows go only with their job, which can be deleted only while PENDING).
model JobEvent {
  id         String       @id @default(uuid(7)) @db.Uuid
  jobId      String       @map("job_id") @db.Uuid
  job        Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  type       JobEventType
  fromStatus JobStatus?   @map("from_status")
  toStatus   JobStatus    @map("to_status")
  actorId    String       @map("actor_id") @db.Uuid
  actor      User         @relation("JobEventActor", fields: [actorId], references: [id], onDelete: Restrict)
  assigneeId String?      @map("assignee_id") @db.Uuid
  assignee   User?        @relation("JobEventAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  /// STARTED and COMPLETED only: the fix the worker's phone reported, if it had one. Device
  /// data (it can be spoofed), recorded for review; all four set or all null (CHECK).
  latitude       Float?    @db.DoublePrecision
  longitude      Float?    @db.DoublePrecision
  accuracyMeters Float?    @map("accuracy_m") @db.DoublePrecision
  locatedAt      DateTime? @map("located_at") @db.Timestamptz(3)
  /// Distance from the job site, computed by the server (null without job coordinates).
  distanceMeters Float?    @map("distance_m") @db.DoublePrecision
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  /// A job's history in order (the details screen).
  @@index([jobId, createdAt])
  @@map("job_events")
}

/// A note the assigned worker recorded in the field, often offline. Append-only: notes never
/// conflict. The ID is generated by the device, so a note keeps it from capture to server.
model JobNote {
  id         String   @id @db.Uuid
  jobId      String   @map("job_id") @db.Uuid
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  authorId   String   @map("author_id") @db.Uuid
  author     User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body       String   @db.VarChar(2000)
  /// Device time of capture: shown to people, never used for ordering (device clocks drift).
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)
  /// Server receipt time: the authoritative order.
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  /// A job's notes in receipt order (details screen, working set).
  @@index([jobId, createdAt])
  @@map("job_notes")
}

/// Server-side idempotency for commands sent by devices (header Idempotency-Key). A row is
/// written in the same transaction as the change it records, so a retried command (a lost
/// response, an app killed mid-sync) is recognized and replayed instead of applied twice.
/// The primary key also stops two concurrent retries from both applying.
/// Owned by the jobs module, the only module with offline commands so far.
model ProcessedMutation {
  userId         String   @map("user_id") @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  idempotencyKey String   @map("idempotency_key") @db.Uuid
  /// The command, for example job.start. Reusing a key for another command is refused.
  operation      String   @db.VarChar(50)
  jobId          String   @map("job_id") @db.Uuid
  /// HTTP status of the original success, returned again on replay.
  responseStatus Int      @map("response_status") @db.SmallInt
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([userId, idempotencyKey])
  @@map("processed_mutations")
}

/// A photo attached to a job by the assigned worker (often captured offline). The database
/// holds metadata only; the bytes live in object storage under `storageKey`. Append-only.
model JobEvidence {
  /// Generated by the device, so offline evidence keeps its ID from capture to server.
  id           String   @id @db.Uuid
  jobId        String   @map("job_id") @db.Uuid
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  uploadedById String   @map("uploaded_by_id") @db.Uuid
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  /// Detected from the file's bytes on the server; the client's claim is ignored.
  contentType  String   @map("content_type") @db.VarChar(50)
  /// Size of the stored (metadata-stripped) file.
  sizeBytes    Int      @map("size_bytes")
  width        Int
  height       Int
  /// Hex SHA-256 of the stored bytes (integrity checks, duplicate detection later).
  sha256       String   @db.Char(64)
  /// Generated by the server from the job and evidence IDs; never from client input.
  storageKey   String   @unique @map("storage_key") @db.VarChar(300)
  /// Device time of capture: shown to people, never used for ordering.
  capturedAt   DateTime @map("captured_at") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  /// A job's evidence in receipt order (details screen, working set, per-job limit).
  @@index([jobId, createdAt])
  @@map("job_evidence")
}

/// A message on a job between its assigned worker and managers. Append-only; the ID comes
/// from the sending device, which makes offline sends idempotent.
model JobMessage {
  id         String   @id @db.Uuid
  jobId      String   @map("job_id") @db.Uuid
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  authorId   String   @map("author_id") @db.Uuid
  author     User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body       String   @db.VarChar(2000)
  /// Device time of writing (informational).
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)
  /// Server receipt time: the authoritative order.
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  /// A job's conversation in receipt order.
  @@index([jobId, createdAt])
  @@map("job_messages")
}

/// A device's FCM registration token. Bound to the session the device signed in with, so
/// signing out (or any revocation) ends push delivery to that device, and a user with two
/// phones has two rows. A token is unique: if it shows up on another session (the phone
/// changed hands), it moves there.
model PushDevice {
  id        String   @id @default(uuid(7)) @db.Uuid
  sessionId String   @unique @map("session_id") @db.Uuid
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Opaque FCM registration token (about 160 characters today).
  token     String   @unique @db.VarChar(512)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// Finding a user's devices when a notification is sent.
  @@index([userId])
  @@map("push_devices")
}

/// Must stay identical to NotificationType in @fieldops/types.
enum NotificationType {
  JOB_ASSIGNED
  JOB_UNASSIGNED
  JOB_CANCELLED
  JOB_COMPLETED
  JOB_MESSAGE
}

/// A user's in-app notification inbox. Written when a domain event concerns the user; push
/// delivery (FCM) is a best-effort copy of the same entry.
model Notification {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  jobId     String           @map("job_id") @db.Uuid
  job       Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  title     String           @db.VarChar(120)
  body      String           @db.VarChar(300)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt    DateTime?        @map("read_at") @db.Timestamptz(3)

  /// The inbox, newest first, with keyset pagination on (created_at, id).
  @@index([userId, createdAt, id])
  @@map("notifications")
}
