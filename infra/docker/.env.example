# FieldOps Docker Compose environment variables
# Copy to infra/docker/.env if overriding defaults.

POSTGRES_USER=fieldops
POSTGRES_PASSWORD=fieldops
POSTGRES_DB=fieldops_dev
POSTGRES_PORT=5432

# Random 32+ character secrets for JWT
JWT_ACCESS_SECRET=local-dev-access-secret-minimum-32-chars-long!
JWT_REFRESH_SECRET=local-dev-refresh-secret-minimum-32-chars-long!
