# ------------------------------------------------------------------
# FieldOps .gitignore
# Covers the Node/TypeScript monorepo, React Native (Android), NestJS,
# Prisma, Docker and common editor/OS artifacts.
# ------------------------------------------------------------------

# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/releases

# Build output
dist/
build/
out/
*.tsbuildinfo
coverage/
.turbo/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment & secrets (never commit real secrets)
.env
.env.*
!.env.example
# Mobile env files are public build configuration compiled into the APK (never secrets),
# so they are committed. See apps/mobile/.env.example.
!apps/mobile/.env.development
!apps/mobile/.env.staging
!apps/mobile/.env.production
*.pem
*.p12
*.key

# Android signing (release keystores must never be committed)
*.jks
*.keystore
!**/debug.keystore
keystore.properties
google-services.json

# Android / Gradle
.gradle/
local.properties
**/android/app/build/
**/android/build/
**/android/.cxx/
**/android/app/.cxx/
*.apk
*.aab
*.hprof
captures/
.kotlin/

# iOS (not a target platform yet, but keep generated artifacts out)
**/ios/Pods/
**/ios/build/
*.xcworkspace/xcuserdata/
DerivedData/

# React Native / Metro
.metro-health-check*
*.jsbundle
**/android/app/src/main/assets/index.android.bundle

# Testing
/test-results/
/playwright-report/
.maestro/screenshots/

# Prisma: the generated client is build output (regenerated by `prisma generate` on install)
apps/api/src/generated/
*.db
*.db-journal

# Docker local volumes
infra/docker/data/
infra/docker/volumes/

# Editors / IDEs
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini
